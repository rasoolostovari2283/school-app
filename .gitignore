# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env*.local
*.env
!.env.example
!*/.env.example

# Next.js build output
.next/
*/.next/
out/
*/out/

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend_stage/

# Disposable test-suite artefacts (per-process SQLite files and upload dirs)
backend/.tmp/

# Runtime-generated sync status file
backend/sync_status.json

# Uploads directory contents (preserve directory with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Android build outputs & local config
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/*.iml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript build info
*.tsbuildinfo

# Android APK binary releases (kept locally and on server, excluded from git history)
*.apk

# Built frontend served by Express (generated on build/deploy)
backend/public/
