# EduConnect Backend Environment Configuration
# Copy this file to .env and set strong random secrets (at least 32 bytes each) before starting the server.

NODE_ENV=production
PORT=5000

# JWT Signing Secrets (REQUIRED — generate with: openssl rand -hex 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Allowed Frontend Origin
FRONTEND_URL=http://localhost:3000
